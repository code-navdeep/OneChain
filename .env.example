# OneChain settings.
# Copy this file to a file named .env in the same folder and fill in the four
# required values. .env stays on your computer: it is listed in .gitignore and
# is not built into the Docker image.

# Required — your Dhan API credentials, from your Dhan account's API settings.
# The app renews the access token each time it starts, and again at the 15:30
# end-of-day run on trading days, and writes the new one back into this file.
# A token lives 24 hours: after a longer break (a weekend, say) paste a fresh
# one here before starting the app.
CLIENT_ID=
ACCESS_TOKEN=

# Required — any username and password you choose. The browser asks for them
# when you open the dashboard; the app will not start without them.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional — remove the leading # to use a setting.

# Risk-free rate, as a decimal (0.065 = 6.5%). Without it no Black-Scholes price
# is computed: no model price on the LTP hover, no over/under-valued borders, no
# straddle markers, and the Reversal Curves drawer shows "not computable".
# RISK_FREE_RATE_NSE=0.065
# RISK_FREE_RATE_MCX=0.070

# NSE Black-Scholes prices use the live India VIX. If none has been fetched yet
# today after 09:15 (allowing 5 minutes from the first try), this percentage is
# used instead.
# DEFAULT_VIX=12.0

# MCX Black-Scholes prices use a fixed volatility per commodity, as a decimal.
# The name after MCX_VOLATILITY_ is the asset_name in assets/assets_select.csv,
# in capitals.
# MCX_VOLATILITY_CRUDEOIL=0.30

# Telegram — forward alerts to a chat. Both must be set. Which kinds of alert
# are sent is chosen in config.json, under "telegram_forward".
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Seconds between India VIX fetches while auto-refresh runs (default 60, which
# is also the minimum).
# VIX_REFRESH_INTERVAL=60

# Dhan API connection (defaults shown).
# DHAN_BASE_URL=https://api.dhan.co/v2
# API_TIMEOUT=30
# MAX_RETRIES=3

# Port, only when running without Docker (default 8053). Under Docker the port
# is fixed at 8053 by docker-compose.yml and the start files.
# PORT=8053
